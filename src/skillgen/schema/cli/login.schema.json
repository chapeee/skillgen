{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "login --json",
  "type": "object",
  "required": [
    "ok",
    "command"
  ],
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "command": {
      "const": "login"
    },
    "error": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "storage_state": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "ok": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "url",
      "storage_state"
    ]
  }
}
