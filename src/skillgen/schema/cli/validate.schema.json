{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "validate --json",
  "type": "object",
  "required": [
    "ok",
    "command"
  ],
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "command": {
      "const": "validate"
    },
    "error": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "ok",
          "problems"
        ],
        "properties": {
          "skill": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "description": "Notes that do not fail the check, such as a SKILL.md over its token budget.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "ok": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "results"
    ]
  }
}
