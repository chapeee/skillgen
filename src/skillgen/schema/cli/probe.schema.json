{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "probe --json",
  "type": "object",
  "required": [
    "ok",
    "command"
  ],
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "command": {
      "const": "probe"
    },
    "error": {
      "type": "string"
    },
    "route": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "fields": {
      "type": "integer",
      "minimum": 0
    },
    "proven": {
      "type": "integer",
      "minimum": 0
    },
    "conditions": {
      "type": "integer",
      "minimum": 0
    },
    "dependencies": {
      "type": "integer",
      "minimum": 0
    },
    "capture": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "ok": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "route",
      "skill",
      "fields"
    ]
  }
}
