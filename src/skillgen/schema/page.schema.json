{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Page model (page.json)",
  "type": "object",
  "required": [
    "schema",
    "route",
    "skill",
    "fields",
    "verified"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "enum": [
        "RUNTIME_PROBED",
        "EXTRACTED",
        "CLAUDE_INFERRED",
        "DEVELOPER_CONFIRMED",
        "USER_DEFINED"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "confidence"
      ],
      "properties": {
        "source": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "field",
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "in",
            "not_in",
            "checked",
            "filled"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "min_length": {
          "type": "integer",
          "minimum": 0
        },
        "max_length": {
          "type": "integer",
          "minimum": 0
        },
        "not_future": {
          "type": "boolean"
        }
      }
    },
    "field": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "required": [
        "label",
        "type",
        "strategy",
        "selector"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "means": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "long-text",
            "number",
            "date",
            "email",
            "url",
            "phone",
            "enum",
            "multi-enum",
            "boolean",
            "file",
            "path",
            "rich-text"
          ]
        },
        "format": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "boolean"
        },
        "required_if": {
          "$ref": "#/$defs/condition"
        },
        "visible_if": {
          "$ref": "#/$defs/condition"
        },
        "options_from": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "depends_on": {
              "type": "string"
            },
            "load": {
              "enum": [
                "static",
                "async"
              ]
            },
            "pick_by": {
              "enum": [
                "text",
                "value"
              ]
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_length": {
              "type": "integer",
              "minimum": 0
            },
            "max_length": {
              "type": "integer",
              "minimum": 0
            },
            "minimum": {
              "type": [
                "string",
                "number"
              ]
            },
            "maximum": {
              "type": [
                "string",
                "number"
              ]
            },
            "pattern": {
              "type": "string"
            },
            "accept": {
              "type": "string"
            },
            "max_size": {
              "type": "string"
            }
          }
        },
        "strategy": {
          "enum": [
            "native-input",
            "native-select",
            "choice",
            "aria-combobox",
            "aria-tree",
            "aria-listbox",
            "rich-text",
            "file",
            "steps"
          ]
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "server_checked": {
          "type": "boolean"
        },
        "source": true,
        "confidence": true
      }
    }
  },
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.page/1$"
    },
    "route": {
      "type": "string",
      "pattern": "^/"
    },
    "skill": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "title": {
      "type": "string"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "purpose": {
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    },
    "source_commit": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "means": {
            "type": "string"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "row_selector",
          "add_selector"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "row_selector": {
            "type": "string"
          },
          "add_selector": {
            "type": "string"
          },
          "min_rows": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    },
    "fill_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          },
          {
            "enum": [
              "options_from",
              "visible_if",
              "required_if"
            ]
          }
        ],
        "minItems": 3,
        "maxItems": 3
      }
    },
    "submit": {
      "type": "object",
      "required": [
        "selector"
      ],
      "additionalProperties": false,
      "properties": {
        "selector": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "success": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url_matches": {
              "type": "string"
            },
            "text_appears": {
              "type": "string"
            }
          }
        },
        "field_error": {
          "type": "string"
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/provenance"
          }
        ],
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "check": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "gotchas": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/provenance"
          }
        ],
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        }
      }
    },
    "open": {
      "description": "What to click, in order, before the form is on screen: a CSS selector or text:Label.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "layout": {
      "description": "Where visible fields sat when the probe measured the page. Used to check the page before trusting what the skill knows; never to aim a click.",
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "required": [
        "viewport",
        "boxes"
      ],
      "properties": {
        "viewport": {
          "description": "innerWidth and innerHeight while measuring.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "boxes": {
          "description": "Field key to [left, top, width, height] in document CSS pixels.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "source": {
          "type": "array"
        },
        "confidence": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "views": {
      "description": "Parts of the form shown only after clicks (steps, tabs, dialogs, panels), in fill order.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "enter",
          "fields"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "enter": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "leave": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
